---
export interface Props {
    slug: string;
    title: string;
    publishedAt: string;
    excerpt: string;
}

const { slug, title, publishedAt, excerpt, } = Astro.props;
---

<li>
    <a
        href={`/journal/${slug}`}
        class="group flex flex-col gap-1 px-6 py-5 hover:bg-accent/40"
    >
        <div class="flex items-baseline justify-between gap-4">
            <h3
                class="font-serif text-lg leading-snug group-hover:underline underline-offset-4 decoration-1"
            >
                {title}
            </h3>
            <time
                datetime={publishedAt}
                class="shrink-0 font-mono text-[11px] text-muted-foreground"
            >
                {publishedAt}
            </time>
        </div>
        <p class="text-sm text-muted-foreground line-clamp-2">
            {excerpt}
        </p>
    </a>
</li>
