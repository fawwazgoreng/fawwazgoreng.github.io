---
export interface Props {
  title: string;
  slug: string;
  description: string;
  index?: number;
  status: "Stable" | "In-Progress" | "Legacy";
  techStack: string[]
}

const {
  title,
  slug,
  description,
  index = 0,
  status = "In-Progress",
  techStack
} = Astro.props;
---

<li class="border-b">
    <a
        href={`/projects/${slug}`}
        class="group grid grid-cols-12 items-baseline gap-4 px-1 py-8 hover:bg-accent/30"
    >
        <span
            class="col-span-1 font-mono text-[11px] text-muted-foreground"
        >
            {String(index + 1).padStart(2, "0")}
        </span>
        <div class="col-span-11 md:col-span-7">
            <h3
                class="font-serif text-2xl group-hover:underline underline-offset-4 decoration-1"
            >
                {title}
            </h3>
            <p class="mt-1 text-sm text-muted-foreground line-clamp-1">
                {description}
            </p>
        </div>
        <div
            class="col-span-12 md:col-span-4 flex items-center justify-start md:justify-end gap-3 font-mono text-[11px] text-muted-foreground"
        >
            <span>{status}</span>
            <span class="h-3 w-px bg-border"></span>
            <span>{techStack.slice(0, 2).join(" · ")}</span>
        </div>
    </a>
</li>
