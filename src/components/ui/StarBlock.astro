---
type Props = {
    label: string;
    value: string;
};

const { label, value } = Astro.props as Props;

---

<section class="grid grid-cols-1 gap-4 border-t py-8 md:grid-cols-[160px_1fr]">
    <h3
        class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground pt-1"
    >
        {label}
    </h3>
    <p class="font-serif text-lg leading-relaxed text-foreground">{value}</p>
</section>
