---
import BehaviorCardAstroComponent from "../ui/BehaviorCard.astro";
import { getEntry } from "astro:content";

export type BehaviorCardType = {
    type: string;
    title1: string;
    title2: string;
    description: string;
    reason: string;
};

const entry = await getEntry("behavior" , "data");

if (!entry) {
    throw new Error("Behavior data not found");
}

const data: BehaviorCardType[] = entry.data.items;
---

{
    data.map((item, i) => {
        return (
            <div class="mx-auto max-w-5xl px-6 py-8 md:py-10">
                <BehaviorCardAstroComponent {...item} index={i} />
            </div>
        );
    })
}
