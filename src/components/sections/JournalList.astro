---
import JournalCardAstroComponent from "../ui/JournalCard.astro";
import { getCollection } from "astro:content";

type Props = {
    limit: number;
};

const { limit = 5 } = Astro.props as Props;

export type ProjectCardType = {
    slug: string;
    title: string;
    publishedAt: string;
    excerpt: string;
    body: string;
    tags: string[];
};

const journal = await getCollection("journal");
const data: ProjectCardType[] = journal.map((item) => ({
    slug: item.slug,
    title: item.data.title,
    publishedAt: item.data.publishedAt,
    excerpt: item.data.excerpt,
}));
---

<section aria-labelledby="projects-heading" class="border-t">
    <ol class="divide-y">
        {
            data.map((item, i) => {
                if (i < limit) {
                    return (
                        <div class="mx-auto max-w-5xl px-6">
                            <JournalCardAstroComponent {...item} />
                        </div>
                    );
                }
            })
        }
    </ol>
</section>
