<header class="sticky top-0 z-10 border-b bg-background/80 backdrop-blur">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a
            href="/"
            class="font-serif text-base tracking-tight hover:opacity-80"
        >
            <span class:list={["italic", {
                "text-foreground":
                    Astro.url.pathname === "/",
                "text-muted-foreground":
                    Astro.url.pathname !== "/",
            }]}>Home</span>
        </a>

        <nav aria-label="Primary" class="flex items-center gap-6">
            <a
                href="/projects"
                class:list={[
                    "font-mono text-xs uppercase tracking-[0.2em] hover:text-foreground",
                    {
                        "text-foreground":
                            Astro.url.pathname.includes("projects"),
                        "text-muted-foreground":
                            !Astro.url.pathname.includes("projects"),
                    },
                ]}
            >
                Projects
            </a>
            <a
                href="/journey"
                class:list={[
                    "font-mono text-xs uppercase tracking-[0.2em] hover:text-foreground",
                    {
                        "text-foreground":
                            Astro.url.pathname.includes("journey"),
                        "text-muted-foreground":
                            !Astro.url.pathname.includes("journey"),
                    },
                ]}
            >
                Journey
            </a>
        </nav>
    </div>
</header>
