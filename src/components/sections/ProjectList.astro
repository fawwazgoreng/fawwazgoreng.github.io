---
import ProjectCardAstroComponent from "../ui/ProjectCard.astro";
import { getCollection } from "astro:content";

type Props = {
    limit: number;
};

const { limit = 5 } = Astro.props as Props;

export type ProjectCardType = {
    title: string;
    slug: string;
    description: string;
    status: "Stable" | "In-Progress" | "Legacy";
    techStack: string[];
};

const projects = await getCollection("projects");
const data: ProjectCardType[] = projects.map((project) => ({
    title: project.data.title,
    slug: project.data.slug,
    description: project.data.description,
    status: project.data.status,
    techStack: project.data.techStack,
}));
---

<section aria-labelledby="projects-heading" class="border-t">
    <ol class="divide-y">
        {
            data.map((item, i) => {
                if (i < limit) {
                    return (
                        <div class="mx-auto max-w-5xl px-6">
                            <ProjectCardAstroComponent {...item} index={i} />
                        </div>
                    );
                }
            })
        }
    </ol>
</section>
