---
import Layout from "../../layouts/Layout.astro";
import NavbarAstroComponent from "../../components/sections/Navbar.astro";
import StarBlock from "../../components/ui/StarBlock.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const allProjects = await getCollection("projects");
    return allProjects.map((item) => ({
        params: { slug: item.data.slug },
        props: { project: item },
    }));
}

const { project: selectedProject } = Astro.props;
const { slug } = Astro.params;

const statusColor: Record<"Stable" | "In-Progress" | "Legacy", string> = {
    Stable: "text-[var(--status-optimal)]",
    "In-Progress": "text-[var(--status-progress)]",
    Legacy: "text-[var(--status-draft)]",
};
---

{
    selectedProject ? (
        <Layout>
            <NavbarAstroComponent />
            <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
                <header class="mb-12">
                    <div class="mb-6 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.3em]">
                        <span class={statusColor[selectedProject.data.status]}>
                            ● {selectedProject.data.status}
                        </span>
                        <span class="text-muted-foreground">/</span>
                    </div>

                    <h1 class="font-serif text-4xl md:text-6xl leading-[1.05] tracking-tight">
                        {selectedProject.data.title}
                    </h1>
                    <p class="mt-6 max-w-2xl text-base text-muted-foreground">
                        {selectedProject.data.description}
                    </p>

                    <ul class="mt-8 flex flex-wrap gap-x-2 gap-y-2 font-mono text-[11px]">
                        {selectedProject.data.techStack.map((t) => (
                            <li class="hairline px-2 py-0.5 text-muted-foreground">
                                {t}
                            </li>
                        ))}
                    </ul>

                    {(selectedProject.data.repoUrl ||
                        selectedProject.data.liveUrl) && (
                        <div class="mt-6 flex gap-6 font-mono text-xs uppercase tracking-[0.2em]">
                            {selectedProject.data.repoUrl && (
                                <a
                                    href={selectedProject.data.repoUrl}
                                    class="border-b border-border pb-0.5 hover:border-foreground"
                                >
                                    Repository →
                                </a>
                            )}
                            {selectedProject.data.liveUrl && (
                                <a
                                    href={selectedProject.data.liveUrl}
                                    class="border-b border-border pb-0.5 hover:border-foreground"
                                >
                                    Live →
                                </a>
                            )}
                        </div>
                    )}
                </header>

                <section aria-labelledby="case-study">
                    <h2 id="case-study" class="sr-only">
                        Case study
                    </h2>
                    <StarBlock
                        label="Situation"
                        value={selectedProject.data.star.situation}
                    />
                    <StarBlock
                        label="Task"
                        value={selectedProject.data.star.task}
                    />
                    <StarBlock
                        label="Action"
                        value={selectedProject.data.star.action}
                    />
                    <StarBlock
                        label="Result"
                        value={selectedProject.data.star.result}
                    />
                </section>

                {selectedProject.data.body && (
                    <section class="border-t py-10">
                        <h2 class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground mb-4">
                            // notes
                        </h2>
                        <div class="font-serif text-lg leading-relaxed text-foreground/90 whitespace-pre-line">
                            {selectedProject.data.body}
                        </div>
                    </section>
                )}

                {selectedProject.data.technicalFailures.length > 0 && (
                    <section
                        aria-labelledby="failures"
                        class="mt-16 hairline bg-card p-8 md:p-10"
                    >
                        <header class="mb-8 flex items-center justify-between">
                            <h2 id="failures" class="font-serif text-2xl">
                                Technical honesty
                            </h2>
                            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground flex ">
                                <p class="mr-3 font-bold">
                                    {
                                        selectedProject.data.technicalFailures
                                            .length
                                    }
                                </p>
                                <p>entr</p>
                                <p>
                                    {selectedProject.data.technicalFailures
                                        .length === 1
                                        ? "y"
                                        : "ies"}
                                </p>
                            </span>
                        </header>

                        <ol class="space-y-10">
                            {selectedProject.data.technicalFailures.map(
                                (f, i) => (
                                    <li>
                                        <h3 class="font-serif text-xl">
                                            <span class="font-mono text-xs text-muted-foreground mr-3">
                                                {String(i + 1).padStart(2, "0")}
                                            </span>
                                            {f.title}
                                        </h3>
                                        <dl class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-[80px_1fr]">
                                            <dt class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground pt-1">
                                                What
                                            </dt>
                                            <dd class="text-sm leading-relaxed">
                                                {f.what}
                                            </dd>
                                            <dt class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground pt-1">
                                                Why
                                            </dt>
                                            <dd class="text-sm leading-relaxed">
                                                {f.why}
                                            </dd>
                                            <dt class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground pt-1">
                                                Lesson
                                            </dt>
                                            <dd class="text-sm leading-relaxed text-foreground">
                                                {f.lesson}
                                            </dd>
                                        </dl>
                                    </li>
                                ),
                            )}
                        </ol>
                    </section>
                )}
            </article>
        </Layout>
    ) : (
        <div class="mx-auto max-w-2xl px-6 py-24 text-center">
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted-foreground">
                404 / project
            </p>
            <h1 class="mt-3 font-serif text-4xl">No project named “{slug}”.</h1>
            <a
                href="/projects"
                class="mt-6 inline-block border-b border-foreground pb-0.5 font-mono text-xs uppercase tracking-[0.2em]"
            >
                Back to projects →
            </a>
        </div>
    )
}
